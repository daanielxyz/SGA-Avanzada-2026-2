# Copiar como .env (no va a git) y llenar. Valores sin comillas.

# Clave del usuario sga de PostgreSQL
DB_PASSWORD=
# Mínimo 32 caracteres
SGA_JWT_SECRETO=
# Primer administrador, opcional: los datos de prueba traen sus propios usuarios (ver README.md). La clave necesita
# mínimo 8 caracteres, con mayúsculas y números
SGA_ADMIN_CORREO=
SGA_ADMIN_CLAVE=

# Documentación de la API en http://localhost:8080/swagger-ui.html (solo en desarrollo)
SGA_DOCUMENTACION_API=true

# Carga los datos de prueba al arrancar, si todavía no hay: 10 apartamentos, un usuario por rol, reservas en todos los
# estados y por los tres canales. Encendido por defecto; en un servidor real va en false
SGA_DATOS_DEMO=true

# Opcionales (si no se definen, se usa el valor de application.properties)
# DB_URL=jdbc:postgresql://localhost:5432/sga
# DB_USER=sga
# Solo en la base publicada (DEC-121): Flyway entra con su propio usuario, dueño de las tablas, y la aplicación con
# DB_USER, que solo lee y escribe. Sin estas dos, Flyway usa DB_USER y DB_PASSWORD
# SPRING_FLYWAY_USER=
# SPRING_FLYWAY_PASSWORD=
# Conexiones abiertas a la vez (por defecto 10; en el plan gratuito de Supabase, 5)
# DB_POOL_MAXIMO=10
# Contraseña de los usuarios de prueba (por defecto, la del README.md)
# SGA_DEMO_CLAVE=
# SGA_CORREO_MODO=local
# SGA_CORREO_USUARIO=
# SGA_CORREO_CLAVE=
# SGA_CORREO_REMITENTE=
# Solo si un frontend se publica en otra dirección que la API (en local no: el proxy de Vite lo evita)
# SGA_CORS_ORIGENES=https://reservas.ejemplo.com,https://pms.ejemplo.com
