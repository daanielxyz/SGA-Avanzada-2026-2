# Copiar como .env (no va a git) y llenar. Valores sin comillas.

# Clave del usuario sga de PostgreSQL
DB_PASSWORD=
# Mínimo 32 caracteres
SGA_JWT_SECRETO=
# Primer administrador: la clave necesita mínimo 8 caracteres, con mayúsculas y números
SGA_ADMIN_CORREO=
SGA_ADMIN_CLAVE=

# Documentación de la API en http://localhost:8080/swagger-ui.html (solo en desarrollo)
SGA_DOCUMENTACION_API=true

# Carga 4 apartamentos de ejemplo con temporadas y tarifas al arrancar, si todavía no hay (solo en desarrollo)
SGA_DATOS_DEMO=true

# Opcionales (si no se definen, se usa el valor de application.properties)
# DB_URL=jdbc:postgresql://localhost:5432/sga
# DB_USER=sga
# SGA_CORREO_MODO=local
# SGA_CORREO_USUARIO=
# SGA_CORREO_CLAVE=
# SGA_CORREO_REMITENTE=
# Solo si un frontend se publica en otra dirección que la API (en local no: el proxy de Vite lo evita)
# SGA_CORS_ORIGENES=https://reservas.ejemplo.com,https://pms.ejemplo.com
