<mxCell id="titulo" value="SGA · Modelo relacional (PostgreSQL)" style="text;html=1;fontSize=26;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="800" height="40" as="geometry"/></mxCell>
<mxCell id="subtitulo" value="Una tabla raíz por agregado + tablas hijas. Verde = ya implementado (Flyway V1–V9; V8 y V9 agregan además las secuencias de los códigos, seq_servicio, seq_politica, seq_temporada, seq_tarifa, seq_bloqueo, seq_titular, seq_folio y seq_reserva, DEC-52). Gris = planeado (versión de migración en el encabezado). Generado desde docs/PLAN.md y docs/DECISIONES.md." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1400" height="30" as="geometry"/></mxCell>
